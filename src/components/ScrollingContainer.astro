---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    list-style: none;
    gap: 20px;
    padding-bottom: 20px;
    overflow-x: auto;
    
    
    >* {
    display: block;
    background-color: lightgray;
    padding: 16px;
    border-radius: 20px;
    width: 350px;
    flex-shrink: 0;
    
    }
  }
</style>
